# --- Database -------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI.
# Leave blank to run the API on the seeded stub with no database at all.
SUPABASE_DB_URL=
# --- Classifier (Member 2, Phase 3) ---------------------------------------
# Leave blank unless you have a real key. A placeholder is worse than nothing:
# the Groq client constructs happily, /health then advertises the Groq
# classifier, and every call 401s through to the baseline instead.
GROQ_API_KEY=
PROMPT_VERSION=v6
# Must match config.py and render.yaml. Below ~60s the rate-limit retry can
# never fit inside the deadline (RETRY_BACKOFF_SECONDS 30/45 plus
# ESTIMATED_CALL_SECONDS 5.0), so a 429'd report silently falls back to the
# baseline rather than being retried at all.
LLM_TIMEOUT_SECONDS=60

# --- Cache ----------------------------------------------------------------
CACHE_PATH=backend/app/llm_cache.sqlite
CACHE_ENABLED=true

# --- Frontend -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
