# --- Database -------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI.
# Leave blank to run the API on the seeded stub with no database at all.
SUPABASE_DB_URL=
# --- Classifier (Member 2, Phase 3) ---------------------------------------
# ANTHROPIC_API_KEY=
PROMPT_VERSION=v1
LLM_TIMEOUT_SECONDS=25

# --- Cache ----------------------------------------------------------------
CACHE_PATH=cache.sqlite3
CACHE_ENABLED=true

# --- Frontend -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
